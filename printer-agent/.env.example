# URL do backend do GestRest em produção (sem barra no final)
GESTREST_API_URL=https://gestrest.app.br

# Chave gerada em Configurações > Impressora no painel do GestRest (como ADMIN).
# Formato: <id-do-restaurante>.<segredo> — copie exatamente como apareceu na tela,
# ela só é mostrada uma vez.
PRINTER_AGENT_KEY=

# Como a ponte manda os bytes pra impressora física — "usb" (padrão) ou "network"
# (impressora Wi-Fi/Ethernet, sem cabo no computador). Ver README.md, seção
# "Modo Wi-Fi/rede", antes de trocar pra "network".
PRINTER_MODE=usb

# --- Só usado quando PRINTER_MODE=usb ---
# Nome do compartilhamento da impressora no Windows — ver README.md, passo
# "Compartilhar a impressora no Windows". Precisa ser EXATAMENTE o nome que você
# deu ao compartilhar (sem espaços é mais seguro).
PRINTER_SHARE_NAME=TICKET

# --- Só usado quando PRINTER_MODE=network ---
# IP da impressora na rede Wi-Fi do restaurante (ver README.md pra descobrir esse IP).
# PRINTER_HOST=192.168.0.50
# Porta "RAW"/JetDirect — praticamente toda impressora térmica de rede usa 9100, não
# precisa mexer a não ser que o manual dela diga outra porta.
# PRINTER_PORT=9100

# A cada quantos milissegundos verificar se chegou ticket novo (padrão 4000 = 4s).
# Não precisa mexer nisso.
POLL_INTERVAL_MS=4000
